# Artefatos gerados (transitórios). Os resultados finais ficam versionados em resultados/
logs/
tmp/
# obs.: tests/tts_amostras/ e resultados/ SÃO versionados (material de teste da entrega)

# Python
__pycache__/
*.pyc
.venv/
venv/

# Modelos / cache
*.bin
.cache/

# Mantém as pastas, ignora o conteúdo gerado
!logs/.gitkeep
!tmp/.gitkeep
