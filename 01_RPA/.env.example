# Copie para .env e ajuste. Nenhuma chave e obrigatoria: o prototipo roda 100% offline.
# API publica gratuita (sem chave) usada para enriquecer o endereco a partir do CEP
CEP_API_URL=https://viacep.com.br/ws/{cep}/json/
CEP_TIMEOUT_S=4
CEP_MAX_RETRIES=3
CEP_BACKOFF_S=1.0
# Abaixo desta confianca o chamado vai para revisao humana
CONFIANCA_MINIMA=0.45
# LLM e OPCIONAL e NAO e usado nesta versao. Se for integrado, a chave fica so aqui:
# LLM_API_KEY=
